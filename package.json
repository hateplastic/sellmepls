{
  "name": "sellmepls",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "prebuild": "npm run contracts:build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:build": "node scripts/compile-all.mjs",
    "contracts:deploy": "tsx scripts/deploy-contract.ts",
    "preflight": "tsx --conditions=react-server scripts/preflight.ts",
    "check:services": "tsx --conditions=react-server scripts/check-services.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "setup:keys": "tsx scripts/setup-keys.ts",
    "pretest": "npm run contracts:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.950.0",
    "@aws-sdk/s3-request-presigner": "^3.950.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.0",
    "@wagmi/core": "^3.6.5",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tronweb": "6.5.1",
    "viem": "^2.43.0",
    "wagmi": "^3.7.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "solc": "^0.8.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "axios": "^1.20.0",
    "uuid": "^11.1.1",
    "stream-json": "^3.6.0",
    "tmp": "^0.2.7"
