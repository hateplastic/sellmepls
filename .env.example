NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ENV=testnet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BASE_RPC_URL=https://sepolia.base.org
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Server-only HTTPS endpoint for the selected environment; use a private provider for mainnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PLATFORM_EVM_WALLET=
PLATFORM_SOLANA_WALLET=
BASE_PAYMENT_ROUTER=
ARBITRUM_PAYMENT_ROUTER=
ETHEREUM_PAYMENT_ROUTER=
BSC_PAYMENT_ROUTER=
TRON_PAYMENT_ROUTER=
PLATFORM_TRON_WALLET=
# Defaults follow NEXT_PUBLIC_CHAIN_ENV. Keep private provider credentials server-only.
# Mainnet TRON uses https://api.trongrid.io; testnet uses https://nile.trongrid.io.
TRON_API_KEY=
EVM_CONFIRMATIONS=1
SOLANA_COMMITMENT=confirmed
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
CRON_SECRET=
REFERRAL_SECRET=
QUOTE_SIGNER_PRIVATE_KEY=
# 32 random bytes as 64 hex characters. Back up securely; required for stock TXT.
INVENTORY_ENCRYPTION_KEY=
MAX_FILE_BYTES=104857600

# Verified login addresses, comma separated. Empty means no admin access.
ADMIN_EVM_WALLETS=
ADMIN_SOLANA_WALLETS=
